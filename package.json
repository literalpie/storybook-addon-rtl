{
  "name": "storybook-addon-rtl",
  "version": "3.0.2",
  "description": "Right-to-left addon for Storybook.",
  "keywords": [
    "directionality",
    "i18n",
    "internationalization",
    "ltr",
    "right-to-left",
    "rtl",
    "storybook",
    "storybook-addon",
    "storybook-addons"
  ],
  "license": "MIT",
  "author": "literalpie <benjaminkindle@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/literalpie/storybook-addon-rtl.git"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "pnpm run clean",
    "build": "tsdown",
    "build:watch": "pnpm run build --watch",
    "start": "run-p build:watch storybook",
    "release": "pnpm run build && auto shipit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "lint": "oxlint .",
    "checks": "pnpm run format && pnpm run lint"
  },
  "devDependencies": {
    "@auto-it/conventional-commits": "^11.3.6",
    "@auto-it/first-time-contributor": "^11.3.6",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/icons": "^2.2.0",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "auto": "^11.3.6",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "storybook": "^10.6.7",
    "tsdown": "^0.23.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.7"
  },
  "peerDependencies": {
    "storybook": "^10.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "auto": {
    "plugins": [
      ["npm", { "setRcToken": false }],
      "conventional-commits",
      "first-time-contributor"
    ]
  },
  "bundler": {
    "managerEntries": [
      "src/manager.ts"
    ],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ]
  },
  "storybook": {
    "displayName": "Storybook Addon RTL",
    "supportedFrameworks": [
      "supported-frameworks"
    ],
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  }
}
